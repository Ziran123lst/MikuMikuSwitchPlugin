+    // 3b. Temporal Anti-Aliasing (TAA) - PS4 Future Tone restore
+    if (Config::enableTaa) {
+        // 1. NOP the per-frame disable call so the game no longer forces TAA off every frame
+        exl::patch::CodePatcher(ADDR_TAA_FRAME_DISABLE).Write<uint32_t>(ARM64_NOP);
+
+        // 2. Replace the quality-flag getter body (0x20C3D0): every call forces the
+        //    16-sample tier (bit4) plus both tier-selector bits (bit22/bit23) into the
+        //    AA flags word at *(gConfig+0x65708F94), so TAA always runs the 16-point
+        //    sampling pattern (PS4 parity; Switch defaults to the 8-point tier, which
+        //    shimmers / feels juddery on emulator), then returns 1 so the TAA
+        //    capability gate at 0x4ABAF4 passes.
+        static const uint32_t sTaa16SampleBody[] = {
+            0xF0005689u, // adrp x9, #0xcdf000
+            0xF9444929u, // ldr  x9, [x9, #0x890]        ; gConfig
+            0x5291F288u, // mov  w8, #0x8f94
+            0x72ACAE08u, // movk w8, #0x6570, lsl #16    ; w8 = 0x65708F94
+            0xB868692Au, // ldr  w10, [x9, x8]           ; flags
+            0x5280020Bu, // mov  w11, #0x10
+            0x72C0180Bu, // movk w11, #0xc0, lsl #16     ; w11 = 0xC00010 (bit4|bit22|bit23)
+            0x2A0B014Au, // orr  w10, w10, w11           ; force 16-sample tier + selectors
+            0xB828692Au, // str  w10, [x9, x8]
+            0x52800020u, // mov  w0, #1
+            0xD65F03C0u, // ret
+        };
+        for (size_t i = 0; i < sizeof(sTaa16SampleBody) / sizeof(uint32_t); i++) {
+            exl::patch::CodePatcher(ADDR_TAA_QUALITY_FLAG + i * 4).Write<uint32_t>(sTaa16SampleBody[i]);
+        }
+
+        // 3. In the TAA enable setter (0x4A0440), always write enable = 1:
+        //    str w1, [x0, #0xC] -> str w8, [x0, #0xC] (w8 == 1 from the mov w8, #1 above)
+        exl::patch::CodePatcher(ADDR_TAA_ENABLE_STR).Write<uint32_t>(0xB9000C08);
+
+        // 4. AA resolve (0x4ABAC0): the resolver clears the temporal-enable register
+        //    w26 to 0 every resolve, which gates off the whole temporal (motion-blur)
+        //    path even when the capability gate passes. Force w26 = 1 so the
+        //    temporal accumulation actually runs (PS4 parity).
+        exl::patch::CodePatcher(ADDR_TAA_RESOLVE_W26).Write<uint32_t>(0x5280003A); // mov w26, #1
+
+        // 5. Jitter path (0x4AE050): the jitter/reprojection stage reads enable from
+        //    [x0, #0xC] and skips the ±0.25 jitter when 0. Force w8 = 1 so the
+        //    temporal jitter (the smooth motion-blur sampling) always executes.
+        exl::patch::CodePatcher(ADDR_TAA_JITTER_FORCE).Write<uint32_t>(0x52800028); // mov w8, #1
+    }
